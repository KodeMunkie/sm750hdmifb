#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

name=${DPKG_MAINTSCRIPT_PACKAGE:-sm750hdmifb}
version=0.5.3

disable_predecessor_file() {
	path=$1
	backup=${path}.disabled-by-sm750hdmifb
	if [ -e "$path" ] && [ ! -e "$backup" ]; then
		mv "$path" "$backup"
	fi
}

# These paths belong only to predecessor releases of this project.
rm -f /etc/modules-load.d/sm750hdmifb.conf
disable_predecessor_file /etc/X11/xorg.conf.d/20-sm750hdmifb-display.conf
disable_predecessor_file /etc/lightdm/lightdm.conf.d/99-sm750hdmifb.conf
disable_predecessor_file /usr/local/lib/xorg/modules/drivers/sm750shadow_drv.so

if ! "/usr/lib/$name/write-xorg-config" \
	/etc/X11/xorg.conf.d/20-sm750hdmidrm.conf; then
	echo "No unique SM750 found; using the generic Xorg OutputClass." >&2
fi

if command -v dkms >/dev/null 2>&1; then
	for predecessor in \
		sm750hdmifb:0.2.2 \
		sm750hdmi-dkms:0.3.0 \
		sm750hdmidrm-xrgb8888-dkms:0.4.0 \
		sm750hdmidrm-xrgb8888-dkms:0.4.1 \
		sm750hdmidrm-rgb565-dither-dkms:0.4.0 \
		sm750hdmidrm-rgb565-dither-dkms:0.4.1; do
		old_name=${predecessor%%:*}
		old_version=${predecessor#*:}
		dkms remove -m "$old_name" -v "$old_version" --all \
			2>/dev/null || true
	done

	dkms status -m "$name" -v "$version" 2>/dev/null | grep -q . || \
		dkms add -m "$name" -v "$version"
	installed_count=0
	for kernel_dir in /lib/modules/*; do
		kernel_version=${kernel_dir##*/}
		case "$kernel_version" in
			6.[89].*|6.[1-9][0-9].*|[7-9].*|[1-9][0-9].*) ;;
			*) continue ;;
		esac
		if [ ! -f "$kernel_dir/build/Makefile" ]; then
			echo "Skipping $kernel_version: matching headers are absent."
			continue
		fi
		dkms install -m "$name" -v "$version" -k "$kernel_version" --force
		depmod -a "$kernel_version"
		update-initramfs -u -k "$kernel_version"
		installed_count=$((installed_count + 1))
	done
	[ "$installed_count" -gt 0 ] || {
		echo "No supported installed kernel has usable headers." >&2
		exit 1
	}
fi

exit 0
